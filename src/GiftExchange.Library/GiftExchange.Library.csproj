<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.AuroraDsql.Npgsql" Version="1.1.0" />
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
    <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageReference Include="Amazon.Lambda.Logging.AspNetCore" Version="5.0.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="Amazon.Lambda.SQSEvents" Version="3.0.1" />
    <PackageReference Include="AWS.Lambda.Powertools.Metrics" Version="3.2.2" />
    <PackageReference Include="AWSSDK.Comprehend" Version="4.0.100.11" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.103.5" />
    <PackageReference Include="AWSSDK.Scheduler" Version="4.0.100.11" />
    <PackageReference Include="AWSSDK.SimpleEmail" Version="4.0.100.11" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.11" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.103.6" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.11" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.101.1" />
    <PackageReference Include="AWS.Lambda.Powertools.Tracing" Version="3.2.2" />
    <!-- Powertools wraps the X-Ray SDK and brings Core and the AWS SDK handler with it. This one
         it does not cover: EF Core query tracing has no Powertools equivalent, so the handler
         stays an explicit reference. -->
    <PackageReference Include="AWSXRayRecorder.Handlers.EntityFramework" Version="1.7.0" />
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="dotenv.net" Version="4.0.2" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\disposable_email_blocklist.conf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GiftExchange.Library.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
