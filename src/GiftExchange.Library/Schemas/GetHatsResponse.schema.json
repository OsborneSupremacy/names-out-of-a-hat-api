{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "hats": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/hatmetadata"
            },
            "description": "List of hat metadata."
        },
        "organizerName": {
            "type": "string",
            "description": "The name the organizer is known by. Empty when they have no hats yet."
        },
        "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The 1-based page these hats are from."
        },
        "pageSize": {
            "type": "integer",
            "minimum": 1,
            "description": "The most hats a page holds. Chosen by the server."
        },
        "totalCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Every hat the organizer has, across all pages."
        }
    },
    "required": [
        "organizerName",
        "hats",
        "page",
        "pageSize",
        "totalCount"
    ],
    "definitions": {
        "hatmetadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "hatId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The unique identifier for the hat."
                },
                "hatName": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 50,
                    "description": "The display name of the hat."
                },
                "status": {
                    "type": "string",
                    "description": "The current status of the gift exchange."
                },
                "statusUpdatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the status last changed."
                }
            },
            "required": [
                "hatId",
                "hatName",
                "status",
                "statusUpdatedAt"
            ]
        }
    }
}
